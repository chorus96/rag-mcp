#!/bin/sh
# =============================================================================
# rag-promote — 검토한 초안(draft/) 문서를 정식 폴더(official/)로 옮기는 명령
# =============================================================================
#
# 이 파일은 템플릿입니다. deploy/install.sh가 설치하면서 아래 @...@ 자리에 경로를 채워
# ~/.local/bin/rag-promote 에 놓습니다.
#
# 사용법
#   rag-promote                                     초안 목록 보기
#   rag-promote draft/foo.md [...]                  초안을 정식 폴더(official/foo.md)로 옮기고 색인
#   rag-promote --overwrite draft/foo.md            정식 위치에 같은 이름의 문서가 있으면 바꾸기
#
# 문서 디렉터리
#   위치는 설정 파일의 RAG_KNOWLEDGE_DIR 입니다. 비어 있거나 없으면 기본 경로
#   (@DATA_DIR@/knowledge)를 씁니다.
#     draft/      초안 — MCP 쓰기 도구로 모델이 만든 문서. 승격할 대상입니다.
#     official/   정식 문서 — 승격한 문서가 여기로 옮겨집니다.
#   인자 <source> 는 문서 디렉터리 기준 상대 경로로, 검색 결과나 rag_add_document 응답의 source 와 같습니다.
#   draft/ 아래의 .md / .pdf 만 받으며, 승격하면 draft/<경로> → official/<경로> 로 하위 경로를 그대로
#   유지해 옮깁니다(예: draft/runbooks/foo.md → official/runbooks/foo.md).
#   처리 순서: official/ 에 복사 → 색인 → 초안 파일과 초안 청크 삭제.
#   색인에 실패하면 official/ 을 원래대로 되돌리고 초안은 그대로 둡니다.
#
# 왜 별도 명령인가
#   MCP 쓰기 도구는 모델이 쓰므로 draft/ 아래만 다룹니다. 정식 문서로 올리는 일은 사람이 검토한 뒤
#   이 명령으로만 합니다. rag-ingest와 같은 설정 파일을 읽어 같은 임베딩 설정으로 색인합니다.
set -eu

# --- install.sh가 채우는 값 --------------------------------------------------------------
ENV_FILE=@ENV_FILE@
APP_DIR=@APP_DIR@
VENV=@VENV@
DATA_DIR=@DATA_DIR@

# --- 실행 ----------------------------------------------------------------------------------
# env -i 로 호출한 셸의 환경 변수를 모두 버리고, 꼭 필요한 값과 설정 파일만으로 깨끗한 환경을
# 만들어 실행합니다. 서비스와 같은 조건에서 색인하기 위해서입니다.
#   - 프록시가 필요하면 HTTPS_PROXY 등을 설정 파일에 넣으세요 (셸에서 export 한 값은 무시됩니다).
#   - FASTEMBED_CACHE_PATH: BM25 모델 캐시를 서버와 함께 씁니다 (한 번만 내려받음).
#   - RAG_KNOWLEDGE_DIR: 여기 적은 값은 기본값입니다. 설정 파일에 값이 있으면 그 값이 우선하고,
#     설정 파일의 값이 비어 있으면 기본값으로 되돌립니다 (install.sh, rag-ingest, 서버와 같은 규칙).
# 안쪽 sh 에서 설정 파일을 불러온 뒤(set -a 로 모두 export), 받은 인자를 그대로 promote.py 에 넘깁니다.
exec env -i \
    PATH=/usr/local/bin:/usr/bin:/bin \
    HOME="$HOME" \
    LANG="${LANG:-C.UTF-8}" \
    PYTHONUNBUFFERED=1 \
    FASTEMBED_CACHE_PATH="$DATA_DIR/fastembed_cache" \
    RAG_KNOWLEDGE_DIR="$DATA_DIR/knowledge" \
    /bin/sh -c '
        default_dir=$RAG_KNOWLEDGE_DIR
        set -a
        . "$1"
        set +a
        export RAG_KNOWLEDGE_DIR="${RAG_KNOWLEDGE_DIR:-$default_dir}"
        shift
        exec "$@"
    ' rag-promote "$ENV_FILE" "$VENV/bin/python" "$APP_DIR/promote.py" "$@"
