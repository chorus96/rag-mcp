#!/bin/sh
# =============================================================================
# rag-ingest — rag-mcp 지식 베이스 수집 명령
# =============================================================================
#
# 이 파일은 템플릿입니다. deploy/install.sh가 설치하면서 아래 @...@ 자리에 경로를 채워
# ~/.local/bin/rag-ingest 에 놓습니다.
#
# 사용법
#   rag-ingest              문서 디렉터리(RAG_KNOWLEDGE_DIR)의 문서를 색인
#   rag-ingest --recreate   컬렉션을 지우고 전체를 다시 만듦
#                           (임베딩 모델이나 RAG_HYBRID를 바꾼 뒤, 문서를 지우거나 이름을 바꾼 뒤)
#
# 왜 별도 명령인가
#   rag-mcp 서버와 같은 설정 파일을 읽고 같은 조건으로 실행하므로, 수집과 질의가 항상 같은
#   임베딩 엔드포인트와 모델을 씁니다. 둘이 어긋나면 검색이 아무 경고 없이 망가집니다.
set -eu

# --- install.sh가 채우는 값 --------------------------------------------------------------
ENV_FILE=@ENV_FILE@
APP_DIR=@APP_DIR@
VENV=@VENV@
DATA_DIR=@DATA_DIR@

# --- 실행 ----------------------------------------------------------------------------------
# env -i 로 호출한 셸의 환경 변수를 모두 버리고, 꼭 필요한 값과 설정 파일만으로 깨끗한 환경을
# 만들어 실행합니다. 서비스와 같은 조건에서 수집하기 위해서입니다.
#   - 프록시가 필요하면 HTTPS_PROXY 등을 설정 파일에 넣으세요 (셸에서 export 한 값은 무시됩니다).
#   - FASTEMBED_CACHE_PATH: BM25 모델 캐시를 서버와 함께 씁니다 (한 번만 내려받음).
#   - RAG_KNOWLEDGE_DIR: 여기 적은 값은 기본값이고, 설정 파일에 값이 있으면 그 값이 우선합니다.
# 안쪽 sh 에서 설정 파일을 불러온 뒤(set -a 로 모두 export), 받은 인자 뒤에 --path 를 붙여
# ingest.py 를 실행합니다.
exec env -i \
    PATH=/usr/local/bin:/usr/bin:/bin \
    HOME="$HOME" \
    LANG="${LANG:-C.UTF-8}" \
    PYTHONUNBUFFERED=1 \
    FASTEMBED_CACHE_PATH="$DATA_DIR/fastembed_cache" \
    RAG_KNOWLEDGE_DIR="$DATA_DIR/knowledge" \
    /bin/sh -c '
        set -a
        . "$1"
        set +a
        shift
        exec "$@" --path "$RAG_KNOWLEDGE_DIR"
    ' rag-ingest "$ENV_FILE" "$VENV/bin/python" "$APP_DIR/ingest.py" "$@"
