#!/bin/sh
# 지식 베이스 수집 명령. deploy/install.sh가 설치하면서 아래 경로를 채워 넣습니다.
#   시스템 모드: /usr/local/bin/rag-ingest   (sudo rag-ingest)
#   사용자 모드: ~/.local/bin/rag-ingest     (rag-ingest)
#
#   rag-ingest              # RAG_KNOWLEDGE_DIR 의 문서를 색인
#   rag-ingest --recreate   # 컬렉션을 지우고 전체 재구축
#
# rag-mcp 서버와 같은 설정 파일을 읽어 같은 임베딩 설정으로 실행하므로, 수집과 질의의
# 제공자/모델이 어긋나지 않습니다.
set -eu

# --- install.sh가 채우는 값 ---
ENV_FILE=@ENV_FILE@
APP_DIR=@APP_DIR@
VENV=@VENV@
DATA_DIR=@DATA_DIR@
# 시스템 모드에서만 설정됨 (이 사용자로 전환해 실행). 사용자 모드에서는 비어 있음.
RUN_USER=@RUN_USER@

if [ -n "$RUN_USER" ]; then
    if [ "$(id -u)" -ne 0 ]; then
        echo "rag-ingest: root 권한이 필요합니다 (sudo rag-ingest ...)" >&2
        exit 1
    fi
    AS_USER="runuser -u $RUN_USER --"
    RUN_HOME=$DATA_DIR
else
    AS_USER=""
    RUN_HOME=$HOME
fi

# 호출한 쪽의 환경 변수를 넘기지 않고, 설정 파일만으로 깨끗한 환경을 만들어 실행합니다
# (서비스와 같은 조건). 프록시가 필요하면 HTTPS_PROXY 등을 설정 파일에 넣으세요.
# RAG_KNOWLEDGE_DIR는 기본값이며, 설정 파일에 값이 있으면 그 값이 우선합니다.
# shellcheck disable=SC2086
exec $AS_USER env -i \
    PATH=/usr/local/bin:/usr/bin:/bin \
    HOME="$RUN_HOME" \
    LANG="${LANG:-C.UTF-8}" \
    PYTHONUNBUFFERED=1 \
    FASTEMBED_CACHE_PATH="$DATA_DIR/fastembed_cache" \
    RAG_KNOWLEDGE_DIR="$DATA_DIR/knowledge" \
    /bin/sh -c '
        set -a
        . "$1"
        set +a
        shift
        exec "$@" --path "$RAG_KNOWLEDGE_DIR"
    ' rag-ingest "$ENV_FILE" "$VENV/bin/python" "$APP_DIR/ingest.py" "$@"
