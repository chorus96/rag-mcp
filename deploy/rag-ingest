#!/bin/sh
# =============================================================================
# rag-ingest — rag-mcp 지식 베이스 수집 명령
# =============================================================================
#
# 이 파일은 템플릿입니다. deploy/install.sh가 설치하면서 아래 @...@ 자리에 경로를 채워
# ~/.local/bin/rag-ingest 에 놓습니다.
#
# 사용법
#   rag-ingest              문서 디렉터리의 문서를 모두 색인 (바뀐 문서만이 아니라 전체를 다시 업서트)
#   rag-ingest --recreate   컬렉션을 지우고 전체를 다시 만듦
#                           (임베딩 모델이나 RAG_HYBRID를 바꾼 뒤, 문서를 지우거나 이름을 바꾼 뒤)
#
# 문서 디렉터리
#   위치는 설정 파일의 RAG_KNOWLEDGE_DIR 입니다. 비어 있거나 없으면 기본 경로
#   (@DATA_DIR@/knowledge)를 씁니다.
#     official/   정식 문서 — 사람이 .md / .pdf 를 넣고 이 명령으로 색인합니다.
#     draft/      초안 — MCP 쓰기 도구가 저장할 때 바로 색인하지만, 이 명령도 함께 다시 색인합니다.
#   official/·draft/ 아래의 .md / .pdf 만 수집합니다. 두 폴더 밖에 둔 문서는 건너뛰고 개수를 경고로 알리므로,
#   그런 문서는 official/ 로 옮기세요.
#   검색 결과의 source 는 이 디렉터리 기준 상대 경로(예: official/foo.md)입니다.
#   다시 실행해도 중복이 생기지 않지만, 지우거나 이름을 바꾼 파일의 청크는 --recreate 해야 사라집니다.
#
# 왜 별도 명령인가
#   rag-mcp 서버와 같은 설정 파일을 읽고 같은 조건으로 실행하므로, 수집과 질의가 항상 같은
#   임베딩 엔드포인트와 모델을 씁니다. 둘이 어긋나면 검색이 아무 경고 없이 망가집니다.
set -eu

# --- install.sh가 채우는 값 --------------------------------------------------------------
ENV_FILE=@ENV_FILE@
APP_DIR=@APP_DIR@
VENV=@VENV@
DATA_DIR=@DATA_DIR@

# --- 실행 ----------------------------------------------------------------------------------
# env -i 로 호출한 셸의 환경 변수를 모두 버리고, 꼭 필요한 값과 설정 파일만으로 깨끗한 환경을
# 만들어 실행합니다. 서비스와 같은 조건에서 수집하기 위해서입니다.
#   - 프록시가 필요하면 HTTPS_PROXY 등을 설정 파일에 넣으세요 (셸에서 export 한 값은 무시됩니다).
#   - FASTEMBED_CACHE_PATH: FastEmbed 모델 캐시를 서버와 함께 씁니다 (RAG_SPARSE_MODEL=Qdrant/bm25 일 때만 사용).
#   - RAG_KNOWLEDGE_DIR: 여기 적은 값은 기본값입니다. 설정 파일에 값이 있으면 그 값이 우선하고,
#     설정 파일의 값이 비어 있으면 기본값으로 되돌립니다 (install.sh, 서버와 같은 규칙).
# 안쪽 sh 에서 설정 파일을 불러온 뒤(set -a 로 모두 export), 받은 인자 뒤에 --path <문서 디렉터리>를
# 붙여 ingest.py 를 실행합니다.
exec env -i \
    PATH=/usr/local/bin:/usr/bin:/bin \
    HOME="$HOME" \
    LANG="${LANG:-C.UTF-8}" \
    PYTHONUNBUFFERED=1 \
    FASTEMBED_CACHE_PATH="$DATA_DIR/fastembed_cache" \
    RAG_KNOWLEDGE_DIR="$DATA_DIR/knowledge" \
    /bin/sh -c '
        default_dir=$RAG_KNOWLEDGE_DIR
        set -a
        . "$1"
        set +a
        export RAG_KNOWLEDGE_DIR="${RAG_KNOWLEDGE_DIR:-$default_dir}"
        shift
        exec "$@" --path "$RAG_KNOWLEDGE_DIR"
    ' rag-ingest "$ENV_FILE" "$VENV/bin/python" "$APP_DIR/ingest.py" "$@"
