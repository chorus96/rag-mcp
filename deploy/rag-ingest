#!/bin/sh
# 지식 베이스 수집 명령. deploy/install.sh가 /usr/local/bin/rag-ingest 로 설치합니다.
#
#   sudo rag-ingest              # RAG_KNOWLEDGE_DIR 의 문서를 색인
#   sudo rag-ingest --recreate   # 컬렉션을 지우고 전체 재구축
#
# /etc/rag-mcp/rag-mcp.env 를 읽어 rag-mcp 서버와 같은 임베딩 설정으로 실행하므로,
# 수집과 질의의 제공자/모델이 어긋나지 않습니다.
set -eu

ENV_FILE=/etc/rag-mcp/rag-mcp.env
APP_DIR=/opt/rag-mcp/app
VENV=/opt/rag-mcp/venv
RUN_USER=rag-mcp

if [ "$(id -u)" -ne 0 ]; then
    echo "rag-ingest: root 권한이 필요합니다 (sudo rag-ingest ...)" >&2
    exit 1
fi

# root 환경 변수를 넘기지 않고, 설정 파일만으로 깨끗한 환경을 만들어 실행합니다
# (systemd 서비스와 같은 조건). 설정 파일은 rag-mcp 그룹이 읽을 수 있습니다.
# 프록시가 필요하면 HTTPS_PROXY 등을 설정 파일에 넣으세요.
exec runuser -u "$RUN_USER" -- env -i \
    PATH=/usr/local/bin:/usr/bin:/bin \
    HOME=/var/lib/rag-mcp \
    LANG="${LANG:-C.UTF-8}" \
    PYTHONUNBUFFERED=1 \
    FASTEMBED_CACHE_PATH=/var/lib/rag-mcp/fastembed_cache \
    /bin/sh -c '
        set -a
        . "$1"
        set +a
        shift
        exec "$@" --path "${RAG_KNOWLEDGE_DIR:-/var/lib/rag-mcp/knowledge}"
    ' rag-ingest "$ENV_FILE" "$VENV/bin/python" "$APP_DIR/ingest.py" "$@"
