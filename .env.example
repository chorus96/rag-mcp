# =============================================================================
# rag-mcp 설정 파일
# =============================================================================
#
# 이 파일을 쓰는 곳
#   - 설치한 서버:      ~/.config/rag-mcp/rag-mcp.env
#     (설치 스크립트가 처음 한 번 이 파일을 복사합니다. 이후 재설치해도 덮어쓰지 않습니다.)
#   - 개발용 직접 실행:  .env 로 복사한 뒤  set -a; . ./.env; set +a
#
# 적용 방법
#   설정을 바꾼 뒤 서버를 재시작하세요.
#     systemctl --user restart rag-mcp
#
# 작성 규칙
#   - 반드시 바꿔야 하는 값은 [필수] 표시가 있는 사내 임베딩 서버와 사내 리랭커 항목뿐입니다.
#     나머지는 기본값으로 동작하므로 필요한 것만 주석(#)을 풀어 바꾸세요.
#   - 주석은 항상 별도 줄에 쓰세요. systemd는 `KEY=value  # 주석` 처럼 같은 줄 끝의
#     주석까지 값으로 읽습니다.
#   - .env 는 gitignore 대상입니다. 실제 키나 토큰은 절대 커밋하지 마세요.


# =============================================================================
# 1. 사내 임베딩 서버  [필수]
# =============================================================================
# rag-mcp는 임베딩 모델을 직접 실행하지 않고, 사내에서 운영 중인 임베딩 서버에 요청합니다.
# 서버는 OpenAI 호환 /v1/embeddings 형식이어야 합니다 ({"model", "input": [...]} → data[].embedding).
#
# EMBEDDINGS_BASE_URL 에는 기본값이 없으므로 반드시 지정해야 합니다.
# 주소 끝의 /v1/embeddings 는 자동으로 붙습니다 (주소가 /v1 로 끝나면 /embeddings 만 붙음).
#
# 한국어 문서라면 다국어 모델을 권장합니다. 기본 모델 이름 bge-m3 는 한국어를 포함한 다국어 모델입니다
# (1024차원, 접두사 불필요). 모델 이름은 사내 서버가 쓰는 이름에 정확히 맞추세요.
#
# ⚠ 수집과 질의는 같은 서버와 모델을 써야 합니다. 모델이 바뀌면 반드시 재구축하세요.
#     rag-ingest --recreate

# 사내 임베딩 서버 주소
EMBEDDINGS_BASE_URL=http://embedding.internal.example:8080
# 인증 토큰 (Authorization: Bearer 로 보냄). 인증이 없으면 비워 둠
EMBEDDINGS_API_KEY=
# 사내 서버의 모델 이름
EMBEDDINGS_MODEL=bge-m3

# 질의/문서 작업 접두사 (보통은 설정하지 않음)
#   자동 처리: nomic 계열 -> search_query: / search_document:
#              bge-m3 등 대칭 모델 -> 접두사 없음
#   자동 감지가 모르는 비대칭 모델(e5 등, "query: " / "passage: ")일 때만 지정하세요.
# EMBED_QUERY_PREFIX=
# EMBED_DOC_PREFIX=


# =============================================================================
# 2. 사내 리랭커  [필수]
# =============================================================================
# rag-mcp는 리랭커 모델을 직접 실행하지 않고, 사내에서 운영 중인 리랭커(크로스 인코더)에 요청해
# 검색 후보의 순서를 다시 매깁니다(정밀도 향상).
#   - RERANK_BASE_URL 에는 기본값이 없으므로 반드시 지정해야 합니다. 비어 있으면 검색이 오류를 돌려줍니다.
#   - 서버는 Cohere 호환 rerank 형식이어야 합니다 (vLLM, Infinity, Xinference 등이 제공):
#       {"model", "query", "documents": [...]} → {"results": [{"index", "relevance_score"}]}
#   - 주소 끝의 /v1/rerank 는 자동으로 붙습니다 (주소가 /v1·/v2 로 끝나면 /rerank 만, /rerank 로 끝나면 그대로).
#   - 질의할 때만 동작하므로 리랭커 설정을 바꿔도 재수집이 필요 없습니다.
#   - 설정은 됐는데 호출이 실패하면(서버 중단 등) 리랭킹 없이 원래 순서로 결과를 돌려줍니다.
#     rag_health 로 연결을 확인할 수 있습니다.

# 사내 리랭커 주소
RERANK_BASE_URL=http://rerank.internal.example:8080
# 인증 토큰 (Authorization: Bearer 로 보냄). 인증이 없으면 비워 둠
RERANK_API_KEY=
# 사내 리랭커의 모델 이름 (기본값 bge-reranker-v2-m3, 한국어를 포함한 다국어 모델)
RERANK_MODEL=bge-reranker-v2-m3
# 리랭킹 전에 가져오는 후보 수
# RERANK_CANDIDATES=30
# HTTP 타임아웃 (초)
# RERANK_TIMEOUT=30


# =============================================================================
# 3. 연결
# =============================================================================
# MCP 서버 바인드 주소와 포트. 클라이언트는 http://<서버 주소>:8084/mcp 로 접속합니다.
# 같은 서버에서만 접속한다면 MCP_HOST=127.0.0.1 로 바꿔도 됩니다.
MCP_HOST=0.0.0.0
MCP_PORT=8084

# 참고: 클라이언트가 접속할 주소(RAG_MCP_URL)는 이 파일이 아니라 클라이언트 쪽에서 정합니다.
#   서버는 RAG_MCP_URL 을 읽지 않으므로 여기에 넣어도 효과가 없습니다.
#   Claude Code 플러그인과 프로젝트 .mcp.json 은 환경 변수 RAG_MCP_URL 이 있으면 그 주소로 접속합니다.
#     예) RAG_MCP_URL=http://10.0.0.5:8084/mcp claude
#   위 MCP_PORT 를 바꾸면 클라이언트의 RAG_MCP_URL (또는 플러그인 설정 server_url)도 맞춰 바꾸세요.

# Qdrant 주소와 컬렉션 이름 (설치 스크립트가 같은 서버의 127.0.0.1:6333 에 설치합니다)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rag_kb

# Qdrant 인증 키 (선택). 설정하면 Qdrant 서비스와 rag-mcp가 같은 값을 씁니다.
# 비워 두면 인증 없이 실행됩니다. Qdrant는 127.0.0.1 에만 바인드되므로 단일 서버라면 괜찮습니다.
QDRANT_API_KEY=

# HTTP 타임아웃 (초)
#   기본값: 서버의 Qdrant 연결 30초, 임베딩 요청·수집 60초
#   설정하면 모두 이 값을 씁니다.
# RAG_TIMEOUT_SECONDS=60

# 사내 임베딩 서버나 사내 리랭커에 접속할 때 프록시가 필요하면 지정하세요.
# HTTPS_PROXY=http://proxy.example.com:3128
# NO_PROXY=localhost,127.0.0.1

# 사내 임베딩 서버·리랭커가 사설 CA 인증서(HTTPS)를 쓰면 그 CA가 든 PEM 묶음을 지정하세요.
# 이 파일의 인증서만 신뢰하므로, 두 서버의 인증서를 발급한 CA가 모두 들어 있어야 합니다.
# SSL_CERT_FILE=/etc/pki/tls/certs/internal-ca-bundle.pem


# =============================================================================
# 4. 문서 수집 (rag-ingest)
# =============================================================================
# 문서 디렉터리 — 지식 베이스의 원본. rag-ingest가 아래 폴더의 .md 만 수집합니다(그 밖의 문서는 건너뜀).
#   official/   사람이 관리하는 문서. 파일을 넣고 rag-ingest 로 색인합니다.
# 검색 결과의 source 는 이 디렉터리 기준 경로(예: official/foo.md)입니다. MCP 서버는 이 디렉터리를 읽거나
# 쓰지 않습니다(검색은 색인된 Qdrant만 사용).
# systemd는 ~ 를 풀어 주지 않으므로, 설치 스크립트가 설정 파일을 만들 때 실제 경로(/home/<사용자>/...)로
# 바꿔 넣습니다. 경로를 직접 바꾸면 새 경로 아래에 official/ 을 만들어 문서를 넣으세요.
RAG_KNOWLEDGE_DIR=~/.local/share/rag-mcp/data/knowledge

# 청크 크기와 겹침 (글자 수)
# CHUNK_SIZE=1500
# CHUNK_OVERLAP=100

# 요청당 처리량. 큰 문서(예: 아주 긴 마크다운)가 한 번에 수 메가바이트짜리 요청이 되지 않도록
# 나눠 보냅니다. 엔드포인트가 413/400 오류를 내면 EMBED_BATCH_SIZE 를 줄이세요.
#   임베딩 요청당 청크 수
# EMBED_BATCH_SIZE=32
#   Qdrant 업서트 요청당 포인트 수
# QDRANT_UPSERT_BATCH=64


# =============================================================================
# 5. 검색
# =============================================================================
# 하이브리드 검색: 의미(밀집) 벡터 + BM25 키워드(희소) 벡터를 RRF로 결합합니다.
# 에러 문자열, 리소스 ID, 컴포넌트 이름처럼 정확한 토큰을 잘 찾습니다.
# 키워드 벡터는 한국어 형태소 분석기 Kiwi로 조사·어미를 떼어 로컬에서 만들므로 API 키도, 내려받을 모델도
# 없습니다. 끄면(false) 의미 검색만 하고 Kiwi를 불러오지 않아 메모리를 아낄 수 있습니다.
# ⚠ 이 값을 바꾸면 컬렉션 구조가 달라지므로 재구축이 필요합니다 (rag-ingest --recreate).
RAG_HYBRID=true

# 검색 결과 기본 개수 / 최대 개수
# RAG_DEFAULT_LIMIT=5
# RAG_MAX_LIMIT=20

# 결과마다 돌려주는 텍스트의 최대 글자 수 (넘으면 truncated: true)
# RAG_SNIPPET_CHARS=1200
