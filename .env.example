# rag-mcp 설정 파일.
#   - 로컬 서버 설치(deploy/install.sh): /etc/rag-mcp/rag-mcp.env 로 복사되며, 수정 후
#     `sudo systemctl restart rag-mcp` 로 적용합니다.
#   - 개발용 직접 실행: .env 로 복사한 뒤 `set -a; . ./.env; set +a` 로 불러옵니다.
# .env는 gitignore 대상입니다 — 실제 값은 절대 커밋하지 마세요.
# 모든 값에 적절한 기본값이 있으니, 바꿔야 하는 것만 수정하세요.
#
# 주의: systemd는 `KEY=value  # 주석` 처럼 같은 줄 끝의 주석을 값의 일부로 읽습니다.
# 주석은 항상 별도 줄에 쓰세요.

############################  연결 / 포트  ############################
# MCP 엔드포인트: http://<서버 주소>:8084/mcp
MCP_HOST=0.0.0.0
MCP_PORT=8084

# Qdrant (install.sh가 같은 서버의 127.0.0.1:6333 에 설치합니다)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rag_kb

# Qdrant 인증 (선택). 설정하면 Qdrant 서비스와 rag-mcp가 같은 값을 사용합니다.
# 비워 두면 인증 없이 실행됩니다 (Qdrant는 127.0.0.1에만 바인드되므로 단일 서버에서는 괜찮습니다).
QDRANT_API_KEY=

# 수집할 문서 디렉터리 (rag-ingest 명령이 사용)
RAG_KNOWLEDGE_DIR=/var/lib/rag-mcp/knowledge

# HTTP 타임아웃 (초). 기본값: 서버의 Qdrant 연결 30, 임베딩 요청·수집·기록 60.
# 설정하면 모두 이 값을 사용합니다.
# RAG_TIMEOUT_SECONDS=60

############################  임베딩 제공자  #############################
# 수집과 질의는 반드시 같은 제공자+모델을 사용해야 합니다 — 수집한 뒤에 둘 중 하나라도
# 바꾸면 전체를 다시 수집해야 합니다:
#   sudo rag-ingest --recreate
#
#   ollama  -> 로컬, 오프라인, API 키 불필요. 최초 1회 내려받기: `ollama pull bge-m3`
#   openai  -> OpenAI 호환 /v1/embeddings 엔드포인트라면 무엇이든 (OpenAI, LiteLLM
#              프록시, 게이트웨이를 통한 Azure, Together, OpenAI 모드의 TEI, ...)

# -------------- ollama 제공자 (기본값) --------------
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDINGS_PROVIDER=ollama
EMBEDDINGS_MODEL=bge-m3

# ------- OpenAI 호환 제공자 (EMBEDDINGS_PROVIDER=openai 일 때만) -------
# EMBEDDINGS_PROVIDER=openai
# 또는 http://litellm:4000 등
# EMBEDDINGS_BASE_URL=https://api.openai.com
# EMBEDDINGS_API_KEY=sk-...
# EMBEDDINGS_MODEL=text-embedding-3-small

# ------- 기본 모델 bge-m3 / 다른 모델로 바꾸기 -------
# 기본값은 한국어를 포함한 다국어 모델 bge-m3(1024차원, 접두사 불필요)입니다.
# 모델을 바꾼 뒤에는 반드시 재구축하세요:
#   sudo rag-ingest --recreate
# 자세한 내용은 docs/DESIGN.md의 "한국어 / 다국어 문서" 섹션을 참고하세요.
#
# 영어 문서만 쓰고 더 가벼운 모델을 원하면 (최초 1회: `ollama pull nomic-embed-text`):
# EMBEDDINGS_MODEL=nomic-embed-text
#
# OpenAI 호환 서버 (예: TEI로 BAAI/bge-m3 서빙):
# EMBEDDINGS_PROVIDER=openai
# EMBEDDINGS_BASE_URL=http://<tei-host>:8080
# EMBEDDINGS_API_KEY=dummy
# EMBEDDINGS_MODEL=BAAI/bge-m3

# 작업 접두사는 자동으로 붙습니다: nomic -> search_query:/search_document:, 대칭
# 모델(OpenAI text-embedding-*) -> 없음. 자동 감지가 놓치는 다른 비대칭 모델 계열을
# 재정의할 때만 설정하세요 (e5/bge는 "query: "/"passage: " 사용):
# EMBED_QUERY_PREFIX=
# EMBED_DOC_PREFIX=

############################  수집 튜닝  ################################
# 청킹 + 쓰기 배치 (ingest.py). 배치는 HTTP 요청 하나의 크기를 제한해, 큰 문서
# 하나(예: 100페이지 PDF)가 수 메가바이트짜리 단일 호출이 되지 않게 합니다.
# CHUNK_SIZE=1500
# CHUNK_OVERLAP=100
# 임베딩 요청당 청크 수 (Ollama에서는 효과 없음)
# EMBED_BATCH_SIZE=32
# Qdrant 업서트 요청당 포인트 수
# QDRANT_UPSERT_BATCH=64

############################  검색 품질  ################################
# 하이브리드 검색 (재현율): 밀집 임베딩 + 로컬 BM25 희소 벡터를 Reciprocal Rank
# Fusion으로 결합합니다. BM25는 밀집 벡터가 놓치는 정확한 토큰(에러 문자열, 리소스 ID,
# 컴포넌트 이름)을 찾아냅니다. FastEmbed로 오프라인 실행되며 키가 필요 없습니다.
# 기본으로 켜져 있습니다. 이 값을 바꾸면 다시 수집해야 합니다 — 컬렉션 스키마가
# 달라지기 때문입니다 (명명된 벡터).
#   sudo rag-ingest --recreate
RAG_HYBRID=true
# FastEmbed 희소 모델 (기본값 BM25)
# RAG_SPARSE_MODEL=Qdrant/bm25

# 크로스 인코더 리랭킹 (정밀도): 상위 후보의 순서를 다시 매겨 가장 좋은 청크가 상위
# 몇 개 안에 오도록 합니다. 기본으로 꺼져 있습니다. 질의 시점에만 동작하므로 다시 수집할
# 필요가 없습니다. 최선형(best-effort): 실패하면 결합된 순서로 되돌아갑니다. 제공자는
# Cohere/Jina 호환 /rerank 엔드포인트입니다.
#
# 제공자: none (기본값) | cohere
#   RERANK_PROVIDER=cohere
# 모델: Cohere 다국어 모델이 기본값 (한국어 포함).
#   Jina는 jina-reranker-v2-base-multilingual, 영어 전용은 rerank-english-v3.0 (Cohere)
#   RERANK_MODEL=rerank-multilingual-v3.0
# API 기본 URL (Jina는 https://api.jina.ai/v1)
#   RERANK_BASE_URL=https://api.cohere.com
#   RERANK_API_KEY=
# 리랭킹 전에 가져오는 밀집 검색 결과 수
#   RERANK_CANDIDATES=30
# 리랭커 HTTP 타임아웃 (초)
#   RERANK_TIMEOUT=30
RERANK_PROVIDER=none

############################  검색 개수 제한 / 내부 API  ####################
# rag_search의 기본 `limit` / `limit`의 최대 상한
# RAG_DEFAULT_LIMIT=5
# RAG_MAX_LIMIT=20
# 검색 결과마다 반환하는 텍스트의 최대 글자 수
# RAG_SNIPPET_CHARS=1200
# 내부 /internal/knowledge/* 쓰기 API(장애 기록 + 피드백)를 보호하는 공유 토큰.
# MCP 도구가 아니므로 설정 여부와 관계없이 LLM에는 보이지 않습니다.
# 비워 두면 열려 있습니다 (개발용). MCP_HOST=0.0.0.0 으로 다른 서버에 포트를 노출한다면
# 반드시 설정하세요.
RAG_INTERNAL_TOKEN=
