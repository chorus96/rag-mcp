# =============================================================================
# rag-mcp 설정 파일
# =============================================================================
#
# 이 파일을 쓰는 곳
#   - 설치한 서버:      ~/.config/rag-mcp/rag-mcp.env
#     (설치 스크립트가 처음 한 번 이 파일을 복사합니다. 이후 재설치해도 덮어쓰지 않습니다.)
#   - 개발용 직접 실행:  .env 로 복사한 뒤  set -a; . ./.env; set +a
#
# 적용 방법
#   설정을 바꾼 뒤 서버를 재시작하세요.
#     systemctl --user restart rag-mcp
#
# 작성 규칙
#   - 반드시 바꿔야 하는 값은 [필수] 표시가 있는 임베딩 엔드포인트뿐입니다.
#     나머지는 기본값으로 동작하므로 필요한 것만 주석(#)을 풀어 바꾸세요.
#   - 주석은 항상 별도 줄에 쓰세요. systemd는 `KEY=value  # 주석` 처럼 같은 줄 끝의
#     주석까지 값으로 읽습니다.
#   - .env 는 gitignore 대상입니다. 실제 키나 토큰은 절대 커밋하지 마세요.


# =============================================================================
# 1. 임베딩 엔드포인트  [필수]
# =============================================================================
# OpenAI 호환 /v1/embeddings 엔드포인트라면 무엇이든 쓸 수 있습니다.
#   직접 띄운 서버: Hugging Face TEI, vLLM, LocalAI 등 (오프라인 운영 가능)
#   호스팅 API:     OpenAI, LiteLLM 프록시, 게이트웨이를 통한 Azure 등
#
# EMBEDDINGS_BASE_URL 에는 기본값이 없으므로 반드시 지정해야 합니다.
# 주소 끝의 /v1 은 자동으로 붙습니다.
#
# 기본 모델 bge-m3 는 한국어를 포함한 다국어 모델입니다 (1024차원, 접두사 불필요).
# 모델 이름은 엔드포인트가 쓰는 이름에 맞추세요 (예: vLLM은 BAAI/bge-m3).
#
# ⚠ 수집과 질의는 같은 엔드포인트와 모델을 써야 합니다. 바꾼 뒤에는 반드시 재구축하세요.
#     rag-ingest --recreate

# --- 예 1) 직접 띄운 서버: 같은 서버의 TEI로 BAAI/bge-m3 서빙 (권장) ---
EMBEDDINGS_BASE_URL=http://localhost:8080
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=bge-m3

# --- 예 2) 호스팅 API: OpenAI (문서 내용이 외부로 전송됩니다) ---
# EMBEDDINGS_BASE_URL=https://api.openai.com
# EMBEDDINGS_API_KEY=sk-...
# EMBEDDINGS_MODEL=text-embedding-3-small

# 질의/문서 작업 접두사 (보통은 설정하지 않음)
#   자동 처리: nomic 계열 -> search_query: / search_document:
#              bge-m3, OpenAI text-embedding-* -> 접두사 없음
#   자동 감지가 모르는 비대칭 모델(e5 등, "query: " / "passage: ")일 때만 지정하세요.
# EMBED_QUERY_PREFIX=
# EMBED_DOC_PREFIX=


# =============================================================================
# 2. 연결
# =============================================================================
# MCP 서버 바인드 주소와 포트. 클라이언트는 http://<서버 주소>:8084/mcp 로 접속합니다.
# 같은 서버에서만 접속한다면 MCP_HOST=127.0.0.1 로 바꿔도 됩니다.
MCP_HOST=0.0.0.0
MCP_PORT=8084

# 참고: 클라이언트가 접속할 주소(RAG_MCP_URL)는 이 파일이 아니라 클라이언트 쪽에서 정합니다.
#   서버는 RAG_MCP_URL 을 읽지 않으므로 여기에 넣어도 효과가 없습니다.
#   Claude Code 플러그인과 프로젝트 .mcp.json 은 환경 변수 RAG_MCP_URL 이 있으면 그 주소로 접속합니다.
#     예) RAG_MCP_URL=http://10.0.0.5:8084/mcp claude
#   위 MCP_PORT 를 바꾸면 클라이언트의 RAG_MCP_URL (또는 플러그인 설정 server_url)도 맞춰 바꾸세요.

# Qdrant 주소와 컬렉션 이름 (설치 스크립트가 같은 서버의 127.0.0.1:6333 에 설치합니다)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rag_kb

# Qdrant 인증 키 (선택). 설정하면 Qdrant 서비스와 rag-mcp가 같은 값을 씁니다.
# 비워 두면 인증 없이 실행됩니다. Qdrant는 127.0.0.1 에만 바인드되므로 단일 서버라면 괜찮습니다.
QDRANT_API_KEY=

# HTTP 타임아웃 (초)
#   기본값: 서버의 Qdrant 연결 30초, 임베딩 요청·수집 60초
#   설정하면 모두 이 값을 씁니다.
# RAG_TIMEOUT_SECONDS=60

# 임베딩·리랭커 API처럼 외부에 접속할 때 프록시가 필요하면 지정하세요.
# HTTPS_PROXY=http://proxy.example.com:3128
# NO_PROXY=localhost,127.0.0.1


# =============================================================================
# 3. 문서 수집 (rag-ingest)
# =============================================================================
# 문서 디렉터리 — 지식 베이스의 원본. rag-ingest가 아래 두 폴더의 .md / .pdf 만 수집합니다(그 밖의 문서는 건너뜀).
#   official/   정식 문서. 사람이 파일을 넣고 rag-ingest 로 색인합니다.
#   draft/      초안. MCP 쓰기 도구(6번 항목)를 켜면 모델이 여기에만 문서를 추가·삭제합니다.
#               사람이 검토한 뒤 rag-promote <source> 로 official/ 에 올립니다.
# 두 폴더 모두 검색되며, 검색 결과의 source(예: official/foo.md, draft/foo.md)로 구분합니다.
# 문서 유형(doc_type)은 폴더 이름입니다: official/ → official, draft/ → draft (search_official / search_draft 가 사용).
# systemd는 ~ 를 풀어 주지 않으므로, 설치 스크립트가 설정 파일을 만들 때 실제 경로(/home/<사용자>/...)로
# 바꿔 넣습니다. 경로를 직접 바꾸면 새 경로 아래에 official/ 을 만들어 문서를 넣으세요
# (draft/ 는 쓰기 도구가 처음 저장할 때 자동으로 만들어집니다).
RAG_KNOWLEDGE_DIR=~/.local/share/rag-mcp/data/knowledge

# 청크 크기와 겹침 (글자 수)
# CHUNK_SIZE=1500
# CHUNK_OVERLAP=100

# 요청당 처리량. 큰 문서(예: 100페이지 PDF)가 한 번에 수 메가바이트짜리 요청이 되지 않도록
# 나눠 보냅니다. 엔드포인트가 413/400 오류를 내면 EMBED_BATCH_SIZE 를 줄이세요.
#   임베딩 요청당 청크 수
# EMBED_BATCH_SIZE=32
#   Qdrant 업서트 요청당 포인트 수
# QDRANT_UPSERT_BATCH=64


# =============================================================================
# 4. 검색
# =============================================================================
# 하이브리드 검색: 의미(밀집) 벡터 + BM25 키워드(희소) 벡터를 RRF로 결합합니다.
# 에러 문자열, 리소스 ID, 컴포넌트 이름처럼 정확한 토큰을 잘 찾습니다.
# 키워드 벡터는 한국어 형태소 분석기 Kiwi로 조사·어미를 떼어 로컬에서 만들므로 API 키도, 내려받을 모델도
# 없습니다. 끄면(false) 의미 검색만 하고 Kiwi를 불러오지 않아 메모리를 아낄 수 있습니다.
# ⚠ 이 값을 바꾸면 컬렉션 구조가 달라지므로 재구축이 필요합니다 (rag-ingest --recreate).
RAG_HYBRID=true

# 검색 결과 기본 개수 / 최대 개수
# RAG_DEFAULT_LIMIT=5
# RAG_MAX_LIMIT=20

# 결과마다 돌려주는 텍스트의 최대 글자 수 (넘으면 truncated: true)
# RAG_SNIPPET_CHARS=1200


# =============================================================================
# 5. 리랭킹 (선택)
# =============================================================================
# 크로스 인코더로 상위 후보의 순서를 다시 매겨 정밀도를 높입니다.
#   - 질의할 때만 동작하므로 켜고 끌 때 재수집이 필요 없습니다.
#   - 실패하면 리랭킹 없이 원래 순서로 결과를 돌려줍니다.
#   - Cohere/Jina 호환 /rerank 엔드포인트를 씁니다.
#
# 제공자: none (끔, 기본값) | cohere (Cohere/Jina 호환)
RERANK_PROVIDER=none

# 아래는 RERANK_PROVIDER=cohere 일 때만 사용합니다.
#   모델 (기본값: Cohere 다국어 모델, 한국어 포함)
#     Jina: jina-reranker-v2-base-multilingual / 영어 전용: rerank-english-v3.0
# RERANK_MODEL=rerank-multilingual-v3.0
#   API 주소 (Jina는 https://api.jina.ai/v1)
# RERANK_BASE_URL=https://api.cohere.com
# RERANK_API_KEY=
#   리랭킹 전에 가져오는 후보 수
# RERANK_CANDIDATES=30
#   HTTP 타임아웃 (초)
# RERANK_TIMEOUT=30


# =============================================================================
# 6. MCP 쓰기 도구 (선택)
# =============================================================================
# 켜면 LLM이 MCP 도구로 지식 베이스의 문서를 추가·삭제할 수 있습니다.
#   rag_add_document:    RAG_KNOWLEDGE_DIR/draft/<제목>.md 파일로 저장한 뒤 바로 색인
#   rag_delete_document: draft/ 아래 문서 파일과 검색용 청크를 함께 삭제 (되돌릴 수 없음)
# 모델은 draft/ 아래만 다룰 수 있고, 사람이 관리하는 정식 문서(official/)는 건드릴 수 없습니다.
# 초안을 official/ 로 올리는 승격(rag-promote)은 사람만 할 수 있습니다 (3번 항목 참고).
# 꺼져 있으면(기본값) 도구가 등록되지 않아 LLM에는 보이지도 않습니다.
# ⚠ 켜면 모델이 대화 중에 문서를 기록하거나 지울 수 있습니다. 지식 베이스가 잘못된 내용으로 오염되지 않도록
#   신뢰하는 사용자·클라이언트만 접속하는 서버에서만 켜세요.
# RAG_MCP_WRITE=true
# 한 번에 추가할 수 있는 문서 본문의 최대 글자 수
# RAG_MAX_DOC_CHARS=200000
